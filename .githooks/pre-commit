#!/usr/bin/env bash
#
# Pre-commit hook for DatingApp — credential guard.
#
# Deliberately narrow. The previous version flagged any added line containing
# "password", "secret", "api_key" or "token", which meant ordinary identifiers such as
# `var token = ...` or a JSON key `["token"]` blocked legitimate work. A hook that cries
# wolf just teaches everyone to reach for --no-verify, which is worse than no hook at all.
# So this checks for *values*, not words, and it is the only thing it does: integration
# tests belong in CI, not in a pre-commit path that has to stay fast and reliable.
#
# False positive? Append `# pragma: allow-secret` to the offending line.
# Genuinely need to bypass? Use --no-verify and say why in the commit body.

set -uo pipefail

# Lines containing the pragma are excluded before any check runs.
ADDED=$(git diff --cached --no-color -U0 --diff-filter=ACM \
    | grep -E '^\+' \
    | grep -vE '^\+\+\+' \
    | sed 's/^+//' \
    | grep -v 'pragma: allow-secret' || true)

[ -z "$ADDED" ] && exit 0

# ── 1. Known credential formats ───────────────────────────────────────────
# Prefixes issued by real providers. None of these belong in this repository.
if printf '%s\n' "$ADDED" | grep -qE 'gsk_[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16}|xox[baprs]-[A-Za-z0-9-]{10,}|AIza[0-9A-Za-z_-]{35}|BEGIN[ A-Z]*PRIVATE KEY'; then
    echo "❌ A live API key or private key is staged."
    echo "   Move it to .env and read it from the environment (see docker-compose \${VAR})."
    exit 1
fi

# ── 2. Assigned literals ──────────────────────────────────────────────────
# A secret matters only where a value is actually assigned to a secret-shaped name.
# Env lookups, empty strings and obvious placeholders are expected and ignored.
SUSPECT=$(printf '%s\n' "$ADDED" \
    | grep -iE "(password|passwd|secret|api[_-]?key|access[_-]?token|refresh[_-]?token|private[_-]?key|client[_-]?secret)[\"']?[[:space:]]*[:=][[:space:]]*[\"'][^\"']{8,}[\"']" \
    | grep -viE '\$\{|GetEnvironmentVariable|os\.environ|process\.env|getenv|Configuration\[|string\.Empty|""|example|placeholder|changeme|your[_-]|redacted|dummy|fake|sample|<[^>]*>' \
    | grep -viE 'Test123!|root_password|bot_pass_|bot_demo-user|demo_pass' || true)

if [ -n "$SUSPECT" ]; then
    echo "❌ Possible hardcoded credential staged:"
    printf '%s\n' "$SUSPECT" | head -10 | sed 's/^/     /'
    echo ""
    echo "   Read it from the environment instead, or add '# pragma: allow-secret'."
    exit 1
fi

exit 0
