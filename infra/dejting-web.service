[Unit]
Description=DatingApp web + shared infrastructure containers (Flutter + Keycloak + DBs)
Documentation=https://github.com/best-koder-ever/DatingApp
# Only start after docker is ready.
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The unit is generated by install-web-boot-service.sh, which substitutes
# WORKING_DIR with the repo root where docker-compose.yml lives.
WorkingDirectory=__REPO_DIR__
# Bring up the services that persist. The .NET app services are started
# separately by ./dev-start.sh (dotnet run) — see repo README.
ExecStart=/usr/bin/docker compose up -d --no-deps web keycloak keycloak-db user-service-db matchmaking-service-db swipe-service-db photo-service-db messaging-service-db
ExecStop=/usr/bin/docker compose stop web keycloak keycloak-db user-service-db matchmaking-service-db swipe-service-db photo-service-db messaging-service-db
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
