# DatingApp Environment Configuration
# Copy to infra/.env.dev, infra/.env.test, or infra/.env.prod and fill in values.

# ── Keycloak ──
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=change-me-keycloak-db
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# ── MySQL Root ──
MYSQL_ROOT_PASSWORD=change-me-mysql-root

# ── Demo Mode (dev only) ──
DEMO_MODE=false

# ── Tunnel Host (staging/prod) ──
TUNNEL_HOST=your-tunnel.example.com

# ── Cloudflare Tunnel Token (prod) ──
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token

# ── Docker Image Tags ──
IMAGE_TAG=latest
