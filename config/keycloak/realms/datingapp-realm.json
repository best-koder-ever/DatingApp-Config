    {
      "clientId": "dejtingapp-flutter",
      "name": "Flutter Mobile App",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "dejtingapp://callback",
        "com.dejtingapp://oauth2redirect"
      ],
      "webOrigins": ["*"],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
