{
  "realm": "DatingApp",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "internationalizationEnabled": false,
  "clients": [
    {
      "clientId": "matchmaking-service",
      "name": "Matchmaking Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8082/*"
      ],
      "baseUrl": "http://localhost:8082",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_MATCHMAKING",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "matchmaking-service"
          }
        }
      ]
    },
    {
      "clientId": "photo-service",
      "name": "Photo Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8083/*"
      ],
      "baseUrl": "http://localhost:8083",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_PHOTO",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "photo-service"
          }
        }
      ]
    },
    {
      "clientId": "messaging-service",
      "name": "Messaging Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8084/*"
      ],
      "baseUrl": "http://localhost:8084",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_MESSAGING",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "messaging-service"
          }
        }
      ]
    },
    {
      "clientId": "swipe-service",
      "name": "Swipe Service",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:8085/*"
      ],
      "baseUrl": "http://localhost:8085",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_SWIPE",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "swipe-service"
          }
        }
      ]
    },
    {
      "clientId": "dejtingapp-flutter",
      "name": "Flutter Mobile App",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "redirectUris": [
        "dejtingapp://callback",
        "com.dejtingapp://oauth2redirect"
      ],
      "webOrigins": [
        "*"
      ],
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "token.exchange.standard.flow.enabled": "true"
      },
      "protocolMappers": [
        {
          "name": "yarp-gateway-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "yarp-gateway"
          }
        },
        {
          "name": "phone-number-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "phoneNumber",
            "claim.name": "phone_number",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "yarp-gateway",
      "name": "API Gateway",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:9000/*"
      ],
      "baseUrl": "http://localhost:9000",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_YARP",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "yarp-gateway"
          }
        }
      ]
    },
    {
      "clientId": "test-runner",
      "name": "Test Runner Service Account",
      "description": "Confidential client for integration tests and dev tooling. Uses client_credentials grant to get admin-level tokens for test user creation and impersonation.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "secret": "CHANGE_ME_TEST_RUNNER",
      "protocolMappers": [
        {
          "name": "audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "included.client.audience": "yarp-gateway"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "firebase",
      "displayName": "Firebase Phone Auth",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": true,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "dejting-94dec",
        "useJwksUrl": "true",
        "jwksUrl": "https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com",
        "tokenUrl": "https://oauth2.googleapis.com/token",
        "authorizationUrl": "https://accounts.google.com/o/oauth2/auth",
        "issuer": "https://securetoken.google.com/dejting-94dec",
        "defaultScope": "openid",
        "validateSignature": "true",
        "syncMode": "FORCE",
        "backchannelSupported": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "firebase-phone-to-username",
      "identityProviderAlias": "firebase",
      "identityProviderMapper": "hardcoded-attribute-idp-mapper",
      "config": {
        "syncMode": "INHERIT",
        "attribute": "phoneNumberVerified",
        "attribute.value": "true"
      }
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default application user"
      },
      {
        "name": "admin",
        "description": "Administrator"
      }
    ]
  },
  "groups": [],
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "email": "demo@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "Password123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ]
    }
  ],
  "defaultRoles": ["user"],
  "verifyEmail": true,
  "registrationEmailAsUsername": true,
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 50,
      "config": {}
    }
  ],
  "smtpServer": {
    "host": "localhost",
    "port": "1025",
    "from": "noreply@datingapp.local",
    "fromDisplayName": "DatingApp",
    "replyTo": "",
    "replyToDisplayName": "",
    "envelopeFrom": "",
    "ssl": "",
    "starttls": "",
    "auth": ""
  }
