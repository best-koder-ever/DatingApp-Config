{
  "project": "DatingApp",
  "last_updated": "2026-02-02",
  "ai_helpers": {
    "philosophy": "Make the Invisible Visible - AI can verify state instantly without user",
    "always_use": [
      "python3 scripts/ai-verify-state.py - Check database state (1 sec vs asking user)",
      "TestAssertions.assertFixturesLoaded() - In ALL Flutter tests",
      "TestDatabaseQueries.getFixtureUser('name') - Instead of guessing IDs",
      "make test-clean - Reset environment (1 command vs 6 steps)"
    ],
    "fixture_users": ["alice", "bob", "charlie", "diana", "erik"],
    "known_matches": [["bob", "charlie"], ["diana", "erik"]],
    "database_ports": {
      "SwipeServiceDb": 3310,
      "UserServiceDb": 3308,
      "MessagingDb": 3312,
      "PhotoDb": 3311,
      "MatchmakingDb": 3309
    },
    "quick_commands": {
      "check_state": "python3 scripts/ai-verify-state.py",
      "verify_fixtures": "python3 scripts/ai-verify-state.py --assert-minimal",
      "reset_clean": "make test-clean",
      "quick_reset": "make quick-reset",
      "health_check": "make health-check"
    },
    "flutter_helpers": {
      "state_inspection": "import 'helpers/database_queries.dart';",
      "smart_assertions": "import 'helpers/test_assertions.dart';",
      "test_setup": "import 'helpers/test_environment.dart';"
    },
    "documentation": [
      "AI_HELPER_STRATEGIES.md - Complete guide (500+ lines)",
      "AI_HELPERS_README.md - Quick reference",
      "example_ai_helpers_test.dart - Working examples"
    ]
  },
  "workflow": {
    "before_writing_test": "Run: python3 scripts/ai-verify-state.py",
    "in_test_setup": "await TestAssertions.assertFixturesLoaded();",
    "when_debugging": "await TestDatabaseQueries.printCurrentState();",
    "before_asking_user": "Try: python3 scripts/ai-verify-state.py --verbose"
  }
}
