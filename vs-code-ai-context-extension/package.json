{
  "name": "ai-context-preservation",
  "displayName": "AI Context Preservation",
  "description": "Automatically preserves AI conversation context for development projects",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiContext.backup",
        "title": "Backup AI Context"
      },
      {
        "command": "aiContext.autoBackup",
        "title": "Toggle Auto Backup"
      },
      {
        "command": "aiContext.viewStats",
        "title": "View Context Stats"
      }
    ],
    "configuration": {
      "title": "AI Context Preservation",
      "properties": {
        "aiContext.autoBackup": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic context backup"
        },
        "aiContext.backupInterval": {
          "type": "number",
          "default": 5,
          "description": "Backup interval in minutes"
        },
        "aiContext.promptThreshold": {
          "type": "number",
          "default": 10,
          "description": "Number of AI interactions before backup"
        },
        "aiContext.backupOnShutdown": {
          "type": "boolean",
          "default": true,
          "description": "Backup context when VS Code shuts down"
        },
        "aiContext.contextFile": {
          "type": "string",
          "default": "AI_CONTEXT.md",
          "description": "Main context file to update"
        },
        "aiContext.backupDirectory": {
          "type": "string",
          "default": "ai_context_backups",
          "description": "Directory for context backups"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  }
}
