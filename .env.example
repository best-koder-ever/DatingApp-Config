# DatingApp Local Development Credentials
# Copy this to .env and fill in values
# .env is gitignored — safe for secrets

# Keycloak Admin
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# Keycloak Database
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME

# MySQL root (shared across service DBs)
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Service-specific DB users
USERSERVICE_DB_USER=userservice_user
USERSERVICE_DB_PASSWORD=CHANGE_ME
MATCHMAKING_DB_USER=matchmaking_user
MATCHMAKING_DB_PASSWORD=CHANGE_ME
SWIPE_DB_USER=swipe_user
SWIPE_DB_PASSWORD=CHANGE_ME
PHOTO_DB_USER=photoservice_user
PHOTO_DB_PASSWORD=CHANGE_ME
MESSAGING_DB_USER=messaging_user
MESSAGING_DB_PASSWORD=CHANGE_ME
