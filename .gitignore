# Python virtual environments
e2e-tests/venv/

# Sensitive Keys and Certificates
*.key
*.pem
*.p12
*.pfx
private.key
public.key

# Configuration files with sensitive data
appsettings.Development.json
appsettings.Production.json
.env
# Production env (has secret placeholders)
.env.production
# Keep .env.local and .env.docker in version control (no secrets, just URLs)
secrets.json

# JWT Keys and tokens
jwt.key
auth.key
*.jwt

# Database connection strings (if in separate files)
connectionstrings.json

# Build outputs that might contain embedded secrets
bin/
obj/
publish/
out/

# IDE and temporary files
.vs/
.vscode/settings.json
.idea/
*.user
*.suo
*.cache
.DS_Store
Thumbs.db

# Node modules (if any)
node_modules/

# Docker secrets
docker-compose.override.yml
.dockerignore

# Logs that might contain sensitive data
*.log

# Project management and history files
.specstory/
logs/

# Package managers
*.lock
package-lock.json
.old_scaffolds/


# Test Coverage
coverage/
TestResults/
*.coverage
*.coveragexml

# Service repositories (separate repos, cloned by CI/CD)
/UserService/
/MatchmakingService/
/swipe-service/
/photo-service/
/messaging-service/
/dejting-yarp/

# Python bytecode
__pycache__/
*.pyc
*.pyo
.env.staging
.ai-context-snapshot.md
.ai-system-prompt.md
.ai-last-batch-id
ai-tester-service/
forum-service/
